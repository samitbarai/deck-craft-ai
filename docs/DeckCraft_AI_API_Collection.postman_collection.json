            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/pdf/ocr",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "pdf", "ocr"]
            },
            "description": "PRIMARY OCR ENDPOINT: Extract text from image files OR PDF files using enhanced pdf2pic + Tesseract.js processing. This endpoint accepts files with field name 'image' - ideal for image-specific uploads or when semantic clarity is preferred. OPTIMIZED FOR PRESENTATION SLIDES: Step 1: Converts PDF pages to high-quality PNG images using pdf2pic (buffer-based processing). Step 2: Uses Tesseract PSM 11 (sparse text) perfect for slide layouts. Step 3: Extracts text from charts/diagrams/embedded images. Step 4: Combines regular PDF text + OCR results intelligently."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response indicates success', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson).to.have.property('success', true);",
                  "    pm.expect(responseJson).to.have.property('data');",
                  "});",
                  "",
                  "pm.test('OCR data contains required fields', function () {",
                  "    const responseJson = pm.response.json();",
                  "    const data = responseJson.data;",
                  "    pm.expect(data).to.have.property('filename');",
                  "    pm.expect(data).to.have.property('text');",
                  "    pm.expect(data).to.have.property('processingTime');",
                  "    pm.expect(data).to.have.property('textLength');",
                  "    pm.expect(data).to.have.property('type');",
                  "});",
                  "",
                  "pm.test('Response type is either image or pdf', function () {",
                  "    const responseJson = pm.response.json();",
                  "    const type = responseJson.data.type;",
                  "    pm.expect(['image', 'pdf']).to.include(type);",
                  "});",
                  "",
                  "pm.test('PDF responses have page data', function () {",
                  "    const responseJson = pm.response.json();",
                  "    const data = responseJson.data;",
